{
  "root": true,
  "env": { "browser": true, "node": true, "es2021": true, "jest": true, "worker": true },
  "extends": "eslint:recommended",
  "parserOptions": { "ecmaVersion": 2021 },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-redeclare": "off",
    "eqeqeq": "warn"
  }
}
